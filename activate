#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the ZALVO dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `zalvo` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-zalvo-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `zalvo pm
# install` and `zalvo update` keep that check.
# ============================================================================
_ZALVO_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_zalvo_test_env="--test-environment"
_zalvo_expect_extras=""
for _zalvo_arg in "$@"; do
    if [ -n "$_zalvo_expect_extras" ]; then
        _zalvo_test_env="--test-environment=$_zalvo_arg"
        _zalvo_expect_extras=""
        continue
    fi
    case "$_zalvo_arg" in
        --) break ;;
        --test-extras) _zalvo_expect_extras=1 ;;
        --test-extras=*) _zalvo_test_env="--test-environment=${_zalvo_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_zalvo_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _zalvo_arg _zalvo_test_env _zalvo_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _zalvo_arg _zalvo_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_ZALVO_REPO/scripts/_activation.sh"

if ! zalvo_sync "$_ZALVO_REPO" "$_zalvo_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _zalvo_test_env
    return 1 2>/dev/null || exit 1
fi
unset _zalvo_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __ZALVO_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_zalvo_script="$(zalvo_compose_env "$_ZALVO_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _zalvo_script
    return 1 2>/dev/null || exit 1
}
_zalvo_keys="$(printf '%s\n' "$_zalvo_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __ZALVO_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__ZALVO_SAVED_PATH="$PATH"
for _zalvo_k in $_zalvo_keys; do
    eval "__ZALVO_SAVED_$_zalvo_k=\"\${$_zalvo_k+set}\""
    eval "__ZALVO_PRIOR_$_zalvo_k=\${$_zalvo_k-__ZALVO_UNSET__}"
done
zalvo_apply_env "$_zalvo_script"

# This checkout, not whichever `zalvo` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__ZALVO_WORKTREE="$_ZALVO_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__ZALVO_WORKTREE_NAME="$(git -C "$_ZALVO_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__ZALVO_WORKTREE_NAME" ] || [ "$__ZALVO_WORKTREE_NAME" = HEAD ]; then
    __ZALVO_WORKTREE_NAME="$(basename "$_ZALVO_REPO")"
fi
__ZALVO_SAVED_PS1="${PS1-__ZALVO_UNSET__}"
__ZALVO_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__ZALVO_UNSET__}"

_zalvo_worktree_here() {
    _zalvo_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_zalvo_top" && pwd -P)" = "$(cd "$__ZALVO_WORKTREE" && pwd -P)" ]
}

zalvo() {
    _zalvo_worktree_here || {
        printf '%s\n' "zalvo: $(pwd) is outside $__ZALVO_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__ZALVO_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" zalvo "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe zalvo "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python zalvo "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe zalvo "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python zalvo "$@"
        else
            exec python zalvo "$@"
        fi
    )
}

_zalvo_prompt() {
    if [ "$__ZALVO_SAVED_PS1" = "__ZALVO_UNSET__" ]; then
        _zalvo_base_ps1=""
    else
        _zalvo_base_ps1="$__ZALVO_SAVED_PS1"
    fi
    if _zalvo_worktree_here; then
        PS1="($__ZALVO_WORKTREE_NAME) $_zalvo_base_ps1"
    else
        PS1="$_zalvo_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_zalvo_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_zalvo_prompt
fi
_zalvo_prompt

deactivate() {
    export PATH="$__ZALVO_SAVED_PATH"
    for _zalvo_k in $__ZALVO_KEY_LIST; do
        eval "_zalvo_was=\"\$__ZALVO_SAVED_$_zalvo_k\""
        eval "_zalvo_old=\"\$__ZALVO_PRIOR_$_zalvo_k\""
        if [ "$_zalvo_was" != "set" ]; then
            unset "$_zalvo_k"
        else
            export "$_zalvo_k=$_zalvo_old"
        fi
        unset "__ZALVO_SAVED_$_zalvo_k" "__ZALVO_PRIOR_$_zalvo_k"
    done
    if [ "$__ZALVO_SAVED_PS1" = "__ZALVO_UNSET__" ]; then
        unset PS1
    else
        PS1="$__ZALVO_SAVED_PS1"
    fi
    if [ "$__ZALVO_SAVED_PROMPT_COMMAND" = "__ZALVO_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__ZALVO_SAVED_PROMPT_COMMAND"
    fi
    unset __ZALVO_SAVED_PATH __ZALVO_KEY_LIST __ZALVO_ACTIVATED \
          __ZALVO_WORKTREE __ZALVO_WORKTREE_NAME \
          __ZALVO_SAVED_PS1 __ZALVO_SAVED_PROMPT_COMMAND
    unset -f deactivate zalvo _zalvo_worktree_here _zalvo_prompt
    unset _zalvo_k _zalvo_was _zalvo_old _zalvo_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__ZALVO_KEY_LIST="$_zalvo_keys"

# The composition library is not part of the user's shell.
unset -f zalvo_sync zalvo_bootstrap_python zalvo_compose_env zalvo_apply_env \
         zalvo_activation_current zalvo_ensure_env
unset _ZALVO_REPO _zalvo_script _zalvo_keys _zalvo_k _zalvo_top
